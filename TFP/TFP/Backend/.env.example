# Configuration SMTP pour l'envoi d'emails
# Exemple avec Gmail (vous pouvez utiliser un autre service)

# Serveur SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Identifiants SMTP
# Pour Gmail : utilisez un "Mot de passe d'application" (16 caractères)
# Allez sur https://myaccount.google.com/security
# Activez l'authentification à 2 facteurs
# Puis générez un "Mot de passe d'application"
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application

# Email d'envoi
SMTP_FROM_EMAIL=votre-email@gmail.com
SMTP_FROM_NAME=Restaurant Management

# URL du frontend pour les liens de réinitialisation
FRONTEND_URL=http://localhost:5173
